TMDB_API_KEY=your_tmdb_api_key
# Optional: JSON array for multi-key rotation
# TMDB_API_KEYS=["key1","key2"]
# Optional: server port (defaults to 8787)
# API_PORT=8787
# Optional backend NetMirror TV OTP; device keeps its own session.
# Enable with the currently valid OTP; issued tokens are never configured here.
# NETMIRROR_OTP=111111
